{
  "name": "virag-ai",
  "version": "1.3.2",
  "description": "Virag — high-end realtime personal AI desktop assistant",
  "main": "src/main.cjs",
  "author": "Virag",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "install-browser": "playwright install chromium",
    "build:dir": "electron-builder --dir",
    "build:mac": "electron-builder --mac dmg zip",
    "build:win": "electron-builder --win nsis portable",
    "build:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "openai": "^5.20.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.virag.desktop",
    "productName": "Virag",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Virag uses the microphone for realtime voice conversation.",
        "NSCameraUsageDescription": "Virag can use the camera when you explicitly request visual assistance.",
        "NSScreenCaptureUsageDescription": "Virag can analyze your screen when you explicitly ask it to."
      },
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "dmg": {"title": "Virag"},
    "win": {"target": ["nsis", "portable"]},
    "linux": {"target": "AppImage", "category": "Utility"}
  }
}
